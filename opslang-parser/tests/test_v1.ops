#! lang=v1
## 基本構文
let ok = "OK";                      # string型
let t = 2024-01-01T00:00:00Z;       # time型
let d = 1s;                         # duration型
let ti = 2000;                      # 数値型

.                                   # breakpoint機能
assert 2 == 2;                      # WINGS: check_value
assert_eq 2 2;
assert_approx_eq 1.0 1.0 0.001;     # WINGS: --tolerance 0.001
print 2;                            # WINGS: get
wait 5s;                            # WINGS: wait_sec
wait 1 == 1 && 2 <= 2;              # WINGS: wait_until
wait 0 == 1 || 5s;                  # タイムアウトつき

print &MOBC.HK;                   # telemetry id 参照
print MOBC.HK.XX.YY;
let hk = MOBC.HK;                   # テレメトリ集合型
print hk.OBC.XX.YY;                 # テレメトリ集合型は構造体のように参照できる

MOBC.RT.NOP;                        # Time Indicator をとらないコマンド
MOBC.TL.NOP :20;                    # ステップ単位のTime Indicatorをとるコマンド
:20 MOBC.TL.NOP;                    # Time Indicatorは前置が可能
MOBC.BL.NOP :30;
MOBC.UTL.NOP :2024-01-01T00:00:00Z; # 時刻をTime Indicatorとしてとるコマンド
MOBC.TL.NOP :20 @AOBC;              # 最終的な実行コンポーネントが異なるコマンド (WINGSのMOBC_TL.AOBC_RTに相当)
