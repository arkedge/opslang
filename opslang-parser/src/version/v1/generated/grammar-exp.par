%start Program0
%title "opslang v1 grammar"
%grammar_type 'lalr(1)'
%auto_newline_off
%on Hash %enter Cmnt

%scanner Cmnt {
    %auto_newline_off
    %auto_ws_off
    %on EndOfLine %enter INITIAL
}

%%

/*   0 */ Program0: Program;
/*   1 */ EndOfLine: <INITIAL, Cmnt>/\r?\n|\r/;
/*   2 */ Comment: Hash CommentOpt /* Option */;
/*   3 */ CommentOpt /* Option<T>::Some */: CommentContent;
/*   4 */ CommentOpt /* Option<T>::None */: ;
/*   5 */ Hash: '#';
/*   6 */ CommentContent: <Cmnt>/[^\r\n]*/;
/*   7 */ Program: Definition EndOfLine Program;
/*   8 */ Program: Definition;
/*   9 */ Definition: DefinitionOpt /* Option */ DefinitionOpt0 /* Option */;
/*  10 */ DefinitionOpt0 /* Option<T>::Some */: Comment;
/*  11 */ DefinitionOpt0 /* Option<T>::None */: ;
/*  12 */ DefinitionOpt /* Option<T>::Some */: DefinitionOptGroup;
/*  13 */ DefinitionOptGroup: FunctionDef;
/*  14 */ DefinitionOptGroup: ConstantDef;
/*  15 */ DefinitionOpt /* Option<T>::None */: ;
/*  16 */ FunctionDef: 'prc' Ident '(' FunctionDefOpt /* Option */ ')' Block;
/*  17 */ FunctionDefOpt /* Option<T>::Some */: ParameterList;
/*  18 */ FunctionDefOpt /* Option<T>::None */: ;
/*  19 */ ParameterList: Parameter ParameterListOpt /* Option */;
/*  20 */ ParameterListOpt /* Option<T>::Some */: CommaParameterList;
/*  21 */ ParameterListOpt /* Option<T>::None */: ;
/*  22 */ CommaParameterList: ',' CommaParameterListOpt /* Option */;
/*  23 */ CommaParameterListOpt /* Option<T>::Some */: ParameterList;
/*  24 */ CommaParameterListOpt /* Option<T>::None */: ;
/*  25 */ Parameter: Ident ':' Path;
/*  26 */ ConstantDef: 'const' Ident ':' Path '=' Expr;
/*  27 */ Scope: ScopeContent ScopeOpt /* Option */;
/*  28 */ ScopeOpt /* Option<T>::Some */: EndOfLine Scope;
/*  29 */ ScopeOpt /* Option<T>::None */: ;
/*  30 */ ScopeContent: ScopeContentOpt /* Option */ ScopeContentOpt0 /* Option */ ScopeContentOpt1 /* Option */;
/*  31 */ ScopeContentOpt1 /* Option<T>::Some */: Comment;
/*  32 */ ScopeContentOpt1 /* Option<T>::None */: ;
/*  33 */ ScopeContentOpt0 /* Option<T>::Some */: ScopeContentKind;
/*  34 */ ScopeContentOpt0 /* Option<T>::None */: ;
/*  35 */ ScopeContentOpt /* Option<T>::Some */: Break;
/*  36 */ ScopeContentOpt /* Option<T>::None */: ;
/*  37 */ ScopeContentKind: Statement;
/*  38 */ ScopeContentKind: Block;
/*  39 */ Statement: StatementKind Semi;
/*  40 */ Break: '.';
/*  41 */ Semi: ';';
/*  42 */ StatementKind: LetStmt;
/*  43 */ StatementKind: Expr;
/*  44 */ StatementKind: ReturnStmt;
/*  45 */ LetStmt: 'let' Ident '=' Expr;
/*  46 */ Expr: SetExpr;
/*  47 */ SetExpr: LogicalOrExpr SetExprOpt /* Option */;
/*  48 */ SetExprOpt /* Option<T>::Some */: ':=' LogicalOrExpr;
/*  49 */ SetExprOpt /* Option<T>::None */: ;
/*  50 */ LogicalOrExpr: LogicalOrExprList /* Vec */ LogicalAndExpr;
/*  51 */ LogicalOrExprList /* Vec<T>::Push */: LogicalOrExprList LogicalAndExpr '||';
/*  52 */ LogicalOrExprList /* Vec<T>::New */: ;
/*  53 */ LogicalAndExpr: LogicalAndExprList /* Vec */ InfixInExpr;
/*  54 */ LogicalAndExprList /* Vec<T>::Push */: LogicalAndExprList InfixInExpr '&&';
/*  55 */ LogicalAndExprList /* Vec<T>::New */: ;
/*  56 */ InfixInExpr: CompareExpr InfixInExprOpt /* Option */;
/*  57 */ InfixInExprOpt /* Option<T>::Some */: 'in' CompareExpr;
/*  58 */ InfixInExprOpt /* Option<T>::None */: ;
/*  59 */ CompareExpr: ArithmeticExpr CompareExprList /* Vec */;
/*  60 */ CompareExprList /* Vec<T>::Push */: CompareExprList CompareOp ArithmeticExpr;
/*  61 */ CompareExprList /* Vec<T>::New */: ;
/*  62 */ CompareOp: '>=';
/*  63 */ CompareOp: '<=';
/*  64 */ CompareOp: '>';
/*  65 */ CompareOp: '<';
/*  66 */ CompareOp: '!=';
/*  67 */ CompareOp: '/=';
/*  68 */ CompareOp: '==';
/*  69 */ ArithmeticExpr: ArithmeticExprList /* Vec */ FactorExpr;
/*  70 */ ArithmeticExprList /* Vec<T>::Push */: ArithmeticExprList FactorExpr ArithmeticOp;
/*  71 */ ArithmeticExprList /* Vec<T>::New */: ;
/*  72 */ ArithmeticOp: '+';
/*  73 */ ArithmeticOp: '-';
/*  74 */ FactorExpr: FactorExprList /* Vec */ PrefixExpr;
/*  75 */ FactorExprList /* Vec<T>::Push */: FactorExprList PrefixExpr FactorOp;
/*  76 */ FactorExprList /* Vec<T>::New */: ;
/*  77 */ FactorOp: '*';
/*  78 */ FactorOp: '/';
/*  79 */ FactorOp: '%';
/*  80 */ PrefixExpr: '-' ApplyExpr;
/*  81 */ PrefixExpr: PrefixExprList /* Vec */ ApplyExpr;
/*  82 */ PrefixExprList /* Vec<T>::Push */: PrefixExprList Qualif;
/*  83 */ PrefixExprList /* Vec<T>::New */: ;
/*  84 */ ApplyExpr: LowerPrefixExpr ApplyExprList /* Vec */;
/*  85 */ ApplyExprList /* Vec<T>::Push */: ApplyExprList AtomicExpr;
/*  86 */ ApplyExprList /* Vec<T>::New */: ;
/*  87 */ LowerPrefixExpr: LowerPrefixExprOpt /* Option */ Callable;
/*  88 */ LowerPrefixExprOpt /* Option<T>::Some */: LowerPrefixOp;
/*  89 */ LowerPrefixExprOpt /* Option<T>::None */: ;
/*  90 */ LowerPrefixOp: '&';
/*  91 */ LowerPrefixOp: '$';
/*  92 */ Callable: Path;
/*  93 */ Callable: Literal;
/*  94 */ Callable: '(' Expr ')';
/*  95 */ AtomicExpr: Qualif;
/*  96 */ AtomicExpr: ImportExpr;
/*  97 */ AtomicExpr: IfExpr;
/*  98 */ ImportExpr: LowerPrefixExpr ImportExprOpt /* Option */;
/*  99 */ ImportExprOpt /* Option<T>::Some */: '?' Path;
/* 100 */ ImportExprOpt /* Option<T>::None */: ;
/* 101 */ IfExpr: 'if' Expr Block IfExprOpt /* Option */;
/* 102 */ IfExprOpt /* Option<T>::Some */: 'else' Block;
/* 103 */ IfExprOpt /* Option<T>::None */: ;
/* 104 */ Qualif: Modifier;
/* 105 */ Qualif: DefaultModifier;
/* 106 */ DefaultModifier: '~' Path;
/* 107 */ Modifier: '@' Path ModifierOpt /* Option */;
/* 108 */ ModifierOpt /* Option<T>::Some */: KindArg;
/* 109 */ ModifierOpt /* Option<T>::None */: ;
/* 110 */ KindArg: ':' Callable;
/* 111 */ Path: Ident PathList /* Vec */;
/* 112 */ PathList /* Vec<T>::Push */: PathList '.' Ident;
/* 113 */ PathList /* Vec<T>::New */: ;
/* 114 */ Ident: /[_a-zA-Z](\w|[\/-])*/;
/* 115 */ Literal: Array;
/* 116 */ Literal: String;
/* 117 */ Literal: ByteLiteral;
/* 118 */ Literal: HexByteLiteral;
/* 119 */ Literal: Numeric;
/* 120 */ Literal: Rfc3339DateTime;
/* 121 */ Array: '[' ArrayOpt /* Option */ ']';
/* 122 */ ArrayOpt /* Option<T>::Some */: CommaSepElements;
/* 123 */ ArrayOpt /* Option<T>::None */: ;
/* 124 */ CommaSepElements: Expr CommaSepElementsOpt /* Option */;
/* 125 */ CommaSepElementsOpt /* Option<T>::Some */: CommaExprList;
/* 126 */ CommaSepElementsOpt /* Option<T>::None */: ;
/* 127 */ CommaExprList: ',' CommaExprListOpt /* Option */;
/* 128 */ CommaExprListOpt /* Option<T>::Some */: CommaSepElements;
/* 129 */ CommaExprListOpt /* Option<T>::None */: ;
/* 130 */ String: /"(\\.|[^"])*"/;
/* 131 */ ByteLiteral: /b"(\\.|[^"])*"/;
/* 132 */ HexByteLiteral: /bx"[0-9a-fA-F_]*"/;
/* 133 */ Numeric: BinaryInteger;
/* 134 */ Numeric: OctalInteger;
/* 135 */ Numeric: HexadecimalInteger;
/* 136 */ Numeric: Ieee754Float;
/* 137 */ BinaryInteger: /0b[01_]+([a-zA-Z](\w|[\/-])*)?/;
/* 138 */ OctalInteger: /0o[0-7_]+([a-zA-Z](\w|[\/-])*)?/;
/* 139 */ HexadecimalInteger: /0x[0-9a-fA-F_]+([g-zG-Z](\w|[\/-])*)?/;
/* 140 */ Ieee754Float: /[-+]?(0|[1-9][0-9_]*)(\.[0-9_]+)?([eE][-+]?(0|[1-9][0-9_]*)?)?([a-df-zA-DF-Z](\w|[\/-])*)?/;
/* 141 */ Rfc3339DateTime: /\d{4}-\d{2}-\d{2}[tT]\d{2}:\d{2}:\d{2}(.\d+)?([zZ]|[+-]\d{2}:\d{2})/;
/* 142 */ ReturnStmt: 'return';
/* 143 */ Block: '{' Scope '}';
