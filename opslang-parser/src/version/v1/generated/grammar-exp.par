%start Program
%title "opslang v1 grammar"
%grammar_type 'lalr(1)'
%auto_newline_off
%on BinaryInteger, HexadecimalInteger, Ieee754Float, OctalInteger %enter ReadNumericSuffix
%on Hash %enter Cmnt

%scanner ReadNumericSuffix {
    %auto_newline_off
    %auto_ws_off
    %on Ident, WhiteSpace %enter INITIAL
}
%scanner Cmnt {
    %auto_newline_off
    %auto_ws_off
    %on EndOfLine %enter INITIAL
}

%%

/*   0 */ EndOfLine: <INITIAL, Cmnt>/(?:\r?\n|\r)+/;
/*   1 */ WhiteSpace: <ReadNumericSuffix>/\s+/^ /* Clipped */;
/*   2 */ Comment: Hash^ /* Clipped */ CommentContent;
/*   3 */ Hash: '#';
/*   4 */ CommentContent: <Cmnt>/[^\r\n]*/;
/*   5 */ Program: Scope;
/*   6 */ Scope: ScopeList /* Vec */;
/*   7 */ ScopeList /* Vec<T>::Push */: ScopeList ScopeContent;
/*   8 */ ScopeList /* Vec<T>::New */: ;
/*   9 */ ScopeContent: ScopeContentOpt /* Option */ ScopeContentOpt0 /* Option */ ScopeContentOpt1 /* Option */ EndOfLine;
/*  10 */ ScopeContentOpt1 /* Option<T>::Some */: Comment;
/*  11 */ ScopeContentOpt1 /* Option<T>::None */: ;
/*  12 */ ScopeContentOpt0 /* Option<T>::Some */: ScopeContentKind;
/*  13 */ ScopeContentOpt0 /* Option<T>::None */: ;
/*  14 */ ScopeContentOpt /* Option<T>::Some */: Break;
/*  15 */ ScopeContentOpt /* Option<T>::None */: ;
/*  16 */ ScopeContentKind: Statement;
/*  17 */ ScopeContentKind: Block;
/*  18 */ Statement: StatementKind Semi;
/*  19 */ Break: '.';
/*  20 */ Semi: ';';
/*  21 */ StatementKind: LetStmt;
/*  22 */ StatementKind: Expr;
/*  23 */ StatementKind: ReturnStmt;
/*  24 */ LetStmt: 'let' Ident '=' Expr;
/*  25 */ Expr: SetExpr;
/*  26 */ SetExpr: InfixIfExpr SetExprOpt /* Option */;
/*  27 */ SetExprOpt /* Option<T>::Some */: ':=' InfixIfExpr;
/*  28 */ SetExprOpt /* Option<T>::None */: ;
/*  29 */ InfixIfExpr: LogicalOrExpr InfixIfExprOpt /* Option */;
/*  30 */ InfixIfExprOpt /* Option<T>::Some */: 'if' LogicalOrExpr;
/*  31 */ InfixIfExprOpt /* Option<T>::None */: ;
/*  32 */ LogicalOrExpr: LogicalAndExpr LogicalOrExprList /* Vec */;
/*  33 */ LogicalOrExprList /* Vec<T>::Push */: LogicalOrExprList '||' LogicalAndExpr;
/*  34 */ LogicalOrExprList /* Vec<T>::New */: ;
/*  35 */ LogicalAndExpr: InfixInExpr LogicalAndExprList /* Vec */;
/*  36 */ LogicalAndExprList /* Vec<T>::Push */: LogicalAndExprList '&&' InfixInExpr;
/*  37 */ LogicalAndExprList /* Vec<T>::New */: ;
/*  38 */ InfixInExpr: CompareExpr InfixInExprOpt /* Option */;
/*  39 */ InfixInExprOpt /* Option<T>::Some */: 'in' CompareExpr;
/*  40 */ InfixInExprOpt /* Option<T>::None */: ;
/*  41 */ CompareExpr: ArithmeticExpr CompareExprList /* Vec */;
/*  42 */ CompareExprList /* Vec<T>::Push */: CompareExprList CompareOp ArithmeticExpr;
/*  43 */ CompareExprList /* Vec<T>::New */: ;
/*  44 */ CompareOp: '>=';
/*  45 */ CompareOp: '<=';
/*  46 */ CompareOp: '>';
/*  47 */ CompareOp: '<';
/*  48 */ CompareOp: '!=';
/*  49 */ CompareOp: '/=';
/*  50 */ CompareOp: '==';
/*  51 */ ArithmeticExpr: FactorExpr ArithmeticExprList /* Vec */;
/*  52 */ ArithmeticExprList /* Vec<T>::Push */: ArithmeticExprList ArithmeticOp FactorExpr;
/*  53 */ ArithmeticExprList /* Vec<T>::New */: ;
/*  54 */ ArithmeticOp: '+';
/*  55 */ ArithmeticOp: '-';
/*  56 */ FactorExpr: PrefixExpr FactorExprList /* Vec */;
/*  57 */ FactorExprList /* Vec<T>::Push */: FactorExprList FactorOp PrefixExpr;
/*  58 */ FactorExprList /* Vec<T>::New */: ;
/*  59 */ FactorOp: '*';
/*  60 */ FactorOp: '/';
/*  61 */ FactorOp: '%';
/*  62 */ PrefixExpr: PrefixOp ApplyExpr;
/*  63 */ PrefixExpr: PrefixExprList /* Vec */ ApplyExpr;
/*  64 */ PrefixExprList /* Vec<T>::Push */: PrefixExprList Qualif;
/*  65 */ PrefixExprList /* Vec<T>::New */: ;
/*  66 */ PrefixOp: '-';
/*  67 */ PrefixOp: '&';
/*  68 */ ApplyExpr: Callable ApplyExprList /* Vec */;
/*  69 */ ApplyExprList /* Vec<T>::Push */: ApplyExprList AtomicExpr;
/*  70 */ ApplyExprList /* Vec<T>::New */: ;
/*  71 */ Callable: Path;
/*  72 */ Callable: Literal;
/*  73 */ Callable: '(' Expr ')';
/*  74 */ AtomicExpr: Qualif;
/*  75 */ AtomicExpr: Callable;
/*  76 */ Qualif: ExecutorComponent;
/*  77 */ Qualif: TimeIndicator;
/*  78 */ ExecutorComponent: '@' Path;
/*  79 */ TimeIndicator: ':' Callable;
/*  80 */ Path: Ident PathList /* Vec */;
/*  81 */ PathList /* Vec<T>::Push */: PathList '.' Ident;
/*  82 */ PathList /* Vec<T>::New */: ;
/*  83 */ Ident: <INITIAL, ReadNumericSuffix>/[a-zA-Z][0-9a-zA-Z_\/-]*/;
/*  84 */ Literal: Array;
/*  85 */ Literal: String;
/*  86 */ Literal: ByteLiteral;
/*  87 */ Literal: HexByteLiteral;
/*  88 */ Literal: SuffixedNumeric;
/*  89 */ Literal: FilePathLiteral;
/*  90 */ Literal: Rfc3339DateTime;
/*  91 */ Array: '[' ArrayOpt /* Option */ ']';
/*  92 */ ArrayOpt /* Option<T>::Some */: CommaSepElements;
/*  93 */ ArrayOpt /* Option<T>::None */: ;
/*  94 */ CommaSepElements: Expr CommaSepElementsOpt /* Option */;
/*  95 */ CommaSepElementsOpt /* Option<T>::Some */: CommaExprList;
/*  96 */ CommaSepElementsOpt /* Option<T>::None */: ;
/*  97 */ CommaExprList: ',' CommaExprListOpt /* Option */;
/*  98 */ CommaExprListOpt /* Option<T>::Some */: CommaSepElements;
/*  99 */ CommaExprListOpt /* Option<T>::None */: ;
/* 100 */ String: /"(\\.|[^"])*"/;
/* 101 */ ByteLiteral: /b"(\\.|[^"])*"/;
/* 102 */ HexByteLiteral: /bx"[0-9a-fA-F_]*"/;
/* 103 */ Numeric: BinaryInteger;
/* 104 */ Numeric: OctalInteger;
/* 105 */ Numeric: HexadecimalInteger;
/* 106 */ Numeric: Ieee754Float;
/* 107 */ SuffixedNumeric: Numeric Ident;
/* 108 */ SuffixedNumeric: Numeric WhiteSpace^ /* Clipped */;
/* 109 */ BinaryInteger: /0b[01_]+/;
/* 110 */ OctalInteger: /0o[0-7_]+/;
/* 111 */ HexadecimalInteger: /0x[0-9a-fA-F_]+/;
/* 112 */ Ieee754Float: /[-+]?(0|[1-9][0-9_]*)(\.[0-9_]+)?([eE][-+]?(0|[1-9][0-9_]*)?)?/;
/* 113 */ FilePathLiteral: /os"[0-9a-zA-Z_.,-\/()\[\]]*"/;
/* 114 */ Rfc3339DateTime: /\d{4}-\d{4}-\d{2}[tT]\d{2}:\d{2}:\d{2}(.\d+)?([zZ]|[+-]\d{2}:\d{2})/;
/* 115 */ ReturnStmt: 'return';
/* 116 */ Block: '{' Scope '}';
