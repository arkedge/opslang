%start Program
%title "opslang v1 grammar"
%grammar_type 'lalr(1)'
%auto_newline_off
%on Hash %enter Cmnt

%scanner Cmnt {
    %auto_newline_off
    %auto_ws_off
    %on EndOfLine %enter INITIAL
}

%%

/*   0 */ EndOfLine: <INITIAL, Cmnt>/\r?\n|\r/;
/*   1 */ Comment: Hash CommentOpt /* Option */;
/*   2 */ CommentOpt /* Option<T>::Some */: CommentContent;
/*   3 */ CommentOpt /* Option<T>::None */: ;
/*   4 */ Hash: '#';
/*   5 */ CommentContent: <Cmnt>/[^\r\n]*/;
/*   6 */ Program: Scope;
/*   7 */ Scope: ScopeList /* Vec */;
/*   8 */ ScopeList /* Vec<T>::Push */: ScopeList ScopeContent;
/*   9 */ ScopeList /* Vec<T>::New */: ;
/*  10 */ ScopeContent: ScopeContentOpt /* Option */ ScopeContentOpt0 /* Option */ ScopeContentOpt1 /* Option */ EndOfLine;
/*  11 */ ScopeContentOpt1 /* Option<T>::Some */: Comment;
/*  12 */ ScopeContentOpt1 /* Option<T>::None */: ;
/*  13 */ ScopeContentOpt0 /* Option<T>::Some */: ScopeContentKind;
/*  14 */ ScopeContentOpt0 /* Option<T>::None */: ;
/*  15 */ ScopeContentOpt /* Option<T>::Some */: Break;
/*  16 */ ScopeContentOpt /* Option<T>::None */: ;
/*  17 */ ScopeContentKind: Statement;
/*  18 */ ScopeContentKind: Block;
/*  19 */ Statement: StatementKind Semi;
/*  20 */ Break: '.';
/*  21 */ Semi: ';';
/*  22 */ StatementKind: LetStmt;
/*  23 */ StatementKind: Expr;
/*  24 */ StatementKind: ReturnStmt;
/*  25 */ LetStmt: 'let' Ident '=' Expr;
/*  26 */ Expr: SetExpr;
/*  27 */ SetExpr: InfixIfExpr SetExprOpt /* Option */;
/*  28 */ SetExprOpt /* Option<T>::Some */: ':=' InfixIfExpr;
/*  29 */ SetExprOpt /* Option<T>::None */: ;
/*  30 */ InfixIfExpr: LogicalOrExpr InfixIfExprOpt /* Option */;
/*  31 */ InfixIfExprOpt /* Option<T>::Some */: 'if' LogicalOrExpr;
/*  32 */ InfixIfExprOpt /* Option<T>::None */: ;
/*  33 */ LogicalOrExpr: LogicalOrExprList /* Vec */ LogicalAndExpr;
/*  34 */ LogicalOrExprList /* Vec<T>::Push */: LogicalOrExprList LogicalAndExpr '||';
/*  35 */ LogicalOrExprList /* Vec<T>::New */: ;
/*  36 */ LogicalAndExpr: LogicalAndExprList /* Vec */ InfixInExpr;
/*  37 */ LogicalAndExprList /* Vec<T>::Push */: LogicalAndExprList InfixInExpr '&&';
/*  38 */ LogicalAndExprList /* Vec<T>::New */: ;
/*  39 */ InfixInExpr: CompareExpr InfixInExprOpt /* Option */;
/*  40 */ InfixInExprOpt /* Option<T>::Some */: 'in' CompareExpr;
/*  41 */ InfixInExprOpt /* Option<T>::None */: ;
/*  42 */ CompareExpr: ArithmeticExpr CompareExprList /* Vec */;
/*  43 */ CompareExprList /* Vec<T>::Push */: CompareExprList CompareOp ArithmeticExpr;
/*  44 */ CompareExprList /* Vec<T>::New */: ;
/*  45 */ CompareOp: '>=';
/*  46 */ CompareOp: '<=';
/*  47 */ CompareOp: '>';
/*  48 */ CompareOp: '<';
/*  49 */ CompareOp: '!=';
/*  50 */ CompareOp: '/=';
/*  51 */ CompareOp: '==';
/*  52 */ ArithmeticExpr: ArithmeticExprList /* Vec */ FactorExpr;
/*  53 */ ArithmeticExprList /* Vec<T>::Push */: ArithmeticExprList FactorExpr ArithmeticOp;
/*  54 */ ArithmeticExprList /* Vec<T>::New */: ;
/*  55 */ ArithmeticOp: '+';
/*  56 */ ArithmeticOp: '-';
/*  57 */ FactorExpr: FactorExprList /* Vec */ PrefixExpr;
/*  58 */ FactorExprList /* Vec<T>::Push */: FactorExprList PrefixExpr FactorOp;
/*  59 */ FactorExprList /* Vec<T>::New */: ;
/*  60 */ FactorOp: '*';
/*  61 */ FactorOp: '/';
/*  62 */ FactorOp: '%';
/*  63 */ PrefixExpr: '-' ApplyExpr;
/*  64 */ PrefixExpr: PrefixExprList /* Vec */ ApplyExpr;
/*  65 */ PrefixExprList /* Vec<T>::Push */: PrefixExprList Qualif;
/*  66 */ PrefixExprList /* Vec<T>::New */: ;
/*  67 */ ApplyExpr: LowerPrefixExpr ApplyExprList /* Vec */;
/*  68 */ ApplyExprList /* Vec<T>::Push */: ApplyExprList AtomicExpr;
/*  69 */ ApplyExprList /* Vec<T>::New */: ;
/*  70 */ LowerPrefixExpr: LowerPrefixExprOpt /* Option */ Callable;
/*  71 */ LowerPrefixExprOpt /* Option<T>::Some */: LowerPrefixOp;
/*  72 */ LowerPrefixExprOpt /* Option<T>::None */: ;
/*  73 */ LowerPrefixOp: '&';
/*  74 */ LowerPrefixOp: '$';
/*  75 */ Callable: Path;
/*  76 */ Callable: Literal;
/*  77 */ Callable: '(' Expr ')';
/*  78 */ AtomicExpr: Qualif;
/*  79 */ AtomicExpr: LowerPrefixExpr;
/*  80 */ Qualif: KindSpec;
/*  81 */ Qualif: DefaultAttr;
/*  82 */ DefaultAttr: '~' Path;
/*  83 */ KindSpec: '@' Path KindSpecOpt /* Option */;
/*  84 */ KindSpecOpt /* Option<T>::Some */: KindArg;
/*  85 */ KindSpecOpt /* Option<T>::None */: ;
/*  86 */ KindArg: ':' Callable;
/*  87 */ Path: Ident PathList /* Vec */;
/*  88 */ PathList /* Vec<T>::Push */: PathList '.' Ident;
/*  89 */ PathList /* Vec<T>::New */: ;
/*  90 */ Ident: /[_a-zA-Z](\w|[\/-])*/;
/*  91 */ Literal: Array;
/*  92 */ Literal: String;
/*  93 */ Literal: ByteLiteral;
/*  94 */ Literal: HexByteLiteral;
/*  95 */ Literal: Numeric;
/*  96 */ Literal: FilePathLiteral;
/*  97 */ Literal: Rfc3339DateTime;
/*  98 */ Array: '[' ArrayOpt /* Option */ ']';
/*  99 */ ArrayOpt /* Option<T>::Some */: CommaSepElements;
/* 100 */ ArrayOpt /* Option<T>::None */: ;
/* 101 */ CommaSepElements: Expr CommaSepElementsOpt /* Option */;
/* 102 */ CommaSepElementsOpt /* Option<T>::Some */: CommaExprList;
/* 103 */ CommaSepElementsOpt /* Option<T>::None */: ;
/* 104 */ CommaExprList: ',' CommaExprListOpt /* Option */;
/* 105 */ CommaExprListOpt /* Option<T>::Some */: CommaSepElements;
/* 106 */ CommaExprListOpt /* Option<T>::None */: ;
/* 107 */ String: /"(\\.|[^"])*"/;
/* 108 */ ByteLiteral: /b"(\\.|[^"])*"/;
/* 109 */ HexByteLiteral: /bx"[0-9a-fA-F_]*"/;
/* 110 */ Numeric: BinaryInteger;
/* 111 */ Numeric: OctalInteger;
/* 112 */ Numeric: HexadecimalInteger;
/* 113 */ Numeric: Ieee754Float;
/* 114 */ BinaryInteger: /0b[01_]+([a-zA-Z](\w|[\/-])*)?/;
/* 115 */ OctalInteger: /0o[0-7_]+([a-zA-Z](\w|[\/-])*)?/;
/* 116 */ HexadecimalInteger: /0x[0-9a-fA-F_]+([g-zG-Z](\w|[\/-])*)?/;
/* 117 */ Ieee754Float: /[-+]?(0|[1-9][0-9_]*)(\.[0-9_]+)?([eE][-+]?(0|[1-9][0-9_]*)?)?([a-df-zA-DF-Z](\w|[\/-])*)?/;
/* 118 */ FilePathLiteral: /os"[0-9a-zA-Z_.,-\/()\[\]]*"/;
/* 119 */ Rfc3339DateTime: /\d{4}-\d{2}-\d{2}[tT]\d{2}:\d{2}:\d{2}(.\d+)?([zZ]|[+-]\d{2}:\d{2})/;
/* 120 */ ReturnStmt: 'return';
/* 121 */ Block: '{' Scope '}';
