%start Program
%title "opslang v1 grammar"
%grammar_type 'lalr(1)'
%auto_newline_off
%on Hash %enter Cmnt

%scanner Cmnt {
    %auto_newline_off
    %auto_ws_off
    %on EndOfLine %enter INITIAL
}

%%

/*   0 */ EndOfLine: <INITIAL, Cmnt>/\r?\n|\r/;
/*   1 */ Comment: Hash CommentOpt /* Option */;
/*   2 */ CommentOpt /* Option<T>::Some */: CommentContent;
/*   3 */ CommentOpt /* Option<T>::None */: ;
/*   4 */ Hash: '#';
/*   5 */ CommentContent: <Cmnt>/[^\r\n]*/;
/*   6 */ Program: ProgramList /* Vec */;
/*   7 */ ProgramList /* Vec<T>::Push */: ProgramList Definition;
/*   8 */ ProgramList /* Vec<T>::New */: ;
/*   9 */ Definition: FunctionDef;
/*  10 */ Definition: ConstantDef;
/*  11 */ FunctionDef: 'proc' Ident '(' FunctionDefOpt /* Option */ ')' Block;
/*  12 */ FunctionDefOpt /* Option<T>::Some */: ParameterList;
/*  13 */ FunctionDefOpt /* Option<T>::None */: ;
/*  14 */ ParameterList: Parameter ParameterListOpt /* Option */;
/*  15 */ ParameterListOpt /* Option<T>::Some */: CommaParameterList;
/*  16 */ ParameterListOpt /* Option<T>::None */: ;
/*  17 */ CommaParameterList: ',' CommaParameterListOpt /* Option */;
/*  18 */ CommaParameterListOpt /* Option<T>::Some */: ParameterList;
/*  19 */ CommaParameterListOpt /* Option<T>::None */: ;
/*  20 */ Parameter: Ident ':' Path;
/*  21 */ ConstantDef: 'const' Ident ':' Path '=' Expr;
/*  22 */ Scope: ScopeList /* Vec */;
/*  23 */ ScopeList /* Vec<T>::Push */: ScopeList ScopeContent;
/*  24 */ ScopeList /* Vec<T>::New */: ;
/*  25 */ ScopeContent: ScopeContentOpt /* Option */ ScopeContentOpt0 /* Option */ ScopeContentOpt1 /* Option */ EndOfLine;
/*  26 */ ScopeContentOpt1 /* Option<T>::Some */: Comment;
/*  27 */ ScopeContentOpt1 /* Option<T>::None */: ;
/*  28 */ ScopeContentOpt0 /* Option<T>::Some */: ScopeContentKind;
/*  29 */ ScopeContentOpt0 /* Option<T>::None */: ;
/*  30 */ ScopeContentOpt /* Option<T>::Some */: Break;
/*  31 */ ScopeContentOpt /* Option<T>::None */: ;
/*  32 */ ScopeContentKind: Statement;
/*  33 */ ScopeContentKind: Block;
/*  34 */ Statement: StatementKind Semi;
/*  35 */ Break: '.';
/*  36 */ Semi: ';';
/*  37 */ StatementKind: LetStmt;
/*  38 */ StatementKind: Expr;
/*  39 */ StatementKind: ReturnStmt;
/*  40 */ LetStmt: 'let' Ident '=' Expr;
/*  41 */ Expr: SetExpr;
/*  42 */ SetExpr: LogicalOrExpr SetExprOpt /* Option */;
/*  43 */ SetExprOpt /* Option<T>::Some */: ':=' LogicalOrExpr;
/*  44 */ SetExprOpt /* Option<T>::None */: ;
/*  45 */ LogicalOrExpr: LogicalOrExprList /* Vec */ LogicalAndExpr;
/*  46 */ LogicalOrExprList /* Vec<T>::Push */: LogicalOrExprList LogicalAndExpr '||';
/*  47 */ LogicalOrExprList /* Vec<T>::New */: ;
/*  48 */ LogicalAndExpr: LogicalAndExprList /* Vec */ InfixInExpr;
/*  49 */ LogicalAndExprList /* Vec<T>::Push */: LogicalAndExprList InfixInExpr '&&';
/*  50 */ LogicalAndExprList /* Vec<T>::New */: ;
/*  51 */ InfixInExpr: CompareExpr InfixInExprOpt /* Option */;
/*  52 */ InfixInExprOpt /* Option<T>::Some */: 'in' CompareExpr;
/*  53 */ InfixInExprOpt /* Option<T>::None */: ;
/*  54 */ CompareExpr: ArithmeticExpr CompareExprList /* Vec */;
/*  55 */ CompareExprList /* Vec<T>::Push */: CompareExprList CompareOp ArithmeticExpr;
/*  56 */ CompareExprList /* Vec<T>::New */: ;
/*  57 */ CompareOp: '>=';
/*  58 */ CompareOp: '<=';
/*  59 */ CompareOp: '>';
/*  60 */ CompareOp: '<';
/*  61 */ CompareOp: '!=';
/*  62 */ CompareOp: '/=';
/*  63 */ CompareOp: '==';
/*  64 */ ArithmeticExpr: ArithmeticExprList /* Vec */ FactorExpr;
/*  65 */ ArithmeticExprList /* Vec<T>::Push */: ArithmeticExprList FactorExpr ArithmeticOp;
/*  66 */ ArithmeticExprList /* Vec<T>::New */: ;
/*  67 */ ArithmeticOp: '+';
/*  68 */ ArithmeticOp: '-';
/*  69 */ FactorExpr: FactorExprList /* Vec */ PrefixExpr;
/*  70 */ FactorExprList /* Vec<T>::Push */: FactorExprList PrefixExpr FactorOp;
/*  71 */ FactorExprList /* Vec<T>::New */: ;
/*  72 */ FactorOp: '*';
/*  73 */ FactorOp: '/';
/*  74 */ FactorOp: '%';
/*  75 */ PrefixExpr: '-' ApplyExpr;
/*  76 */ PrefixExpr: PrefixExprList /* Vec */ ApplyExpr;
/*  77 */ PrefixExprList /* Vec<T>::Push */: PrefixExprList Qualif;
/*  78 */ PrefixExprList /* Vec<T>::New */: ;
/*  79 */ ApplyExpr: LowerPrefixExpr ApplyExprList /* Vec */;
/*  80 */ ApplyExprList /* Vec<T>::Push */: ApplyExprList AtomicExpr;
/*  81 */ ApplyExprList /* Vec<T>::New */: ;
/*  82 */ LowerPrefixExpr: LowerPrefixExprOpt /* Option */ Callable;
/*  83 */ LowerPrefixExprOpt /* Option<T>::Some */: LowerPrefixOp;
/*  84 */ LowerPrefixExprOpt /* Option<T>::None */: ;
/*  85 */ LowerPrefixOp: '&';
/*  86 */ LowerPrefixOp: '$';
/*  87 */ Callable: Path;
/*  88 */ Callable: Literal;
/*  89 */ Callable: '(' Expr ')';
/*  90 */ AtomicExpr: Qualif;
/*  91 */ AtomicExpr: ImportExpr;
/*  92 */ AtomicExpr: IfExpr;
/*  93 */ ImportExpr: LowerPrefixExpr ImportExprOpt /* Option */;
/*  94 */ ImportExprOpt /* Option<T>::Some */: '?' Path;
/*  95 */ ImportExprOpt /* Option<T>::None */: ;
/*  96 */ IfExpr: 'if' Expr Block IfExprOpt /* Option */;
/*  97 */ IfExprOpt /* Option<T>::Some */: 'else' Block;
/*  98 */ IfExprOpt /* Option<T>::None */: ;
/*  99 */ Qualif: Modifier;
/* 100 */ Qualif: DefaultModifier;
/* 101 */ DefaultModifier: '~' Path;
/* 102 */ Modifier: '@' Path ModifierOpt /* Option */;
/* 103 */ ModifierOpt /* Option<T>::Some */: KindArg;
/* 104 */ ModifierOpt /* Option<T>::None */: ;
/* 105 */ KindArg: ':' Callable;
/* 106 */ Path: Ident PathList /* Vec */;
/* 107 */ PathList /* Vec<T>::Push */: PathList '.' Ident;
/* 108 */ PathList /* Vec<T>::New */: ;
/* 109 */ Ident: /[_a-zA-Z](\w|[\/-])*/;
/* 110 */ Literal: Array;
/* 111 */ Literal: String;
/* 112 */ Literal: ByteLiteral;
/* 113 */ Literal: HexByteLiteral;
/* 114 */ Literal: Numeric;
/* 115 */ Literal: Rfc3339DateTime;
/* 116 */ Array: '[' ArrayOpt /* Option */ ']';
/* 117 */ ArrayOpt /* Option<T>::Some */: CommaSepElements;
/* 118 */ ArrayOpt /* Option<T>::None */: ;
/* 119 */ CommaSepElements: Expr CommaSepElementsOpt /* Option */;
/* 120 */ CommaSepElementsOpt /* Option<T>::Some */: CommaExprList;
/* 121 */ CommaSepElementsOpt /* Option<T>::None */: ;
/* 122 */ CommaExprList: ',' CommaExprListOpt /* Option */;
/* 123 */ CommaExprListOpt /* Option<T>::Some */: CommaSepElements;
/* 124 */ CommaExprListOpt /* Option<T>::None */: ;
/* 125 */ String: /"(\\.|[^"])*"/;
/* 126 */ ByteLiteral: /b"(\\.|[^"])*"/;
/* 127 */ HexByteLiteral: /bx"[0-9a-fA-F_]*"/;
/* 128 */ Numeric: BinaryInteger;
/* 129 */ Numeric: OctalInteger;
/* 130 */ Numeric: HexadecimalInteger;
/* 131 */ Numeric: Ieee754Float;
/* 132 */ BinaryInteger: /0b[01_]+([a-zA-Z](\w|[\/-])*)?/;
/* 133 */ OctalInteger: /0o[0-7_]+([a-zA-Z](\w|[\/-])*)?/;
/* 134 */ HexadecimalInteger: /0x[0-9a-fA-F_]+([g-zG-Z](\w|[\/-])*)?/;
/* 135 */ Ieee754Float: /[-+]?(0|[1-9][0-9_]*)(\.[0-9_]+)?([eE][-+]?(0|[1-9][0-9_]*)?)?([a-df-zA-DF-Z](\w|[\/-])*)?/;
/* 136 */ Rfc3339DateTime: /\d{4}-\d{2}-\d{2}[tT]\d{2}:\d{2}:\d{2}(.\d+)?([zZ]|[+-]\d{2}:\d{2})/;
/* 137 */ ReturnStmt: 'return';
/* 138 */ Block: '{' Scope '}';
