%start Program
%title "opslang v1 grammar"
%grammar_type 'lalr(1)'
%auto_newline_off
%on Hash %enter Cmnt

%scanner Cmnt {
    %auto_newline_off
    %auto_ws_off
    %on EndOfLine %enter INITIAL
}

%%

/*   0 */ EndOfLine: <INITIAL, Cmnt>/\r?\n|\r/;
/*   1 */ Comment: Hash CommentOpt /* Option */;
/*   2 */ CommentOpt /* Option<T>::Some */: CommentContent;
/*   3 */ CommentOpt /* Option<T>::None */: ;
/*   4 */ Hash: '#';
/*   5 */ CommentContent: <Cmnt>/[^\r\n]*/;
/*   6 */ Program: Scope;
/*   7 */ Scope: ScopeList /* Vec */;
/*   8 */ ScopeList /* Vec<T>::Push */: ScopeList ScopeContent;
/*   9 */ ScopeList /* Vec<T>::New */: ;
/*  10 */ ScopeContent: ScopeContentOpt /* Option */ ScopeContentOpt0 /* Option */ ScopeContentOpt1 /* Option */ EndOfLine;
/*  11 */ ScopeContentOpt1 /* Option<T>::Some */: Comment;
/*  12 */ ScopeContentOpt1 /* Option<T>::None */: ;
/*  13 */ ScopeContentOpt0 /* Option<T>::Some */: ScopeContentKind;
/*  14 */ ScopeContentOpt0 /* Option<T>::None */: ;
/*  15 */ ScopeContentOpt /* Option<T>::Some */: Break;
/*  16 */ ScopeContentOpt /* Option<T>::None */: ;
/*  17 */ ScopeContentKind: Statement;
/*  18 */ ScopeContentKind: Block;
/*  19 */ Statement: StatementKind Semi;
/*  20 */ Break: '.';
/*  21 */ Semi: ';';
/*  22 */ StatementKind: LetStmt;
/*  23 */ StatementKind: Expr;
/*  24 */ StatementKind: ReturnStmt;
/*  25 */ LetStmt: 'let' Ident '=' Expr;
/*  26 */ Expr: SetExpr;
/*  27 */ SetExpr: LogicalOrExpr SetExprOpt /* Option */;
/*  28 */ SetExprOpt /* Option<T>::Some */: ':=' LogicalOrExpr;
/*  29 */ SetExprOpt /* Option<T>::None */: ;
/*  30 */ LogicalOrExpr: LogicalOrExprList /* Vec */ LogicalAndExpr;
/*  31 */ LogicalOrExprList /* Vec<T>::Push */: LogicalOrExprList LogicalAndExpr '||';
/*  32 */ LogicalOrExprList /* Vec<T>::New */: ;
/*  33 */ LogicalAndExpr: LogicalAndExprList /* Vec */ InfixInExpr;
/*  34 */ LogicalAndExprList /* Vec<T>::Push */: LogicalAndExprList InfixInExpr '&&';
/*  35 */ LogicalAndExprList /* Vec<T>::New */: ;
/*  36 */ InfixInExpr: CompareExpr InfixInExprOpt /* Option */;
/*  37 */ InfixInExprOpt /* Option<T>::Some */: 'in' CompareExpr;
/*  38 */ InfixInExprOpt /* Option<T>::None */: ;
/*  39 */ CompareExpr: ArithmeticExpr CompareExprList /* Vec */;
/*  40 */ CompareExprList /* Vec<T>::Push */: CompareExprList CompareOp ArithmeticExpr;
/*  41 */ CompareExprList /* Vec<T>::New */: ;
/*  42 */ CompareOp: '>=';
/*  43 */ CompareOp: '<=';
/*  44 */ CompareOp: '>';
/*  45 */ CompareOp: '<';
/*  46 */ CompareOp: '!=';
/*  47 */ CompareOp: '/=';
/*  48 */ CompareOp: '==';
/*  49 */ ArithmeticExpr: ArithmeticExprList /* Vec */ FactorExpr;
/*  50 */ ArithmeticExprList /* Vec<T>::Push */: ArithmeticExprList FactorExpr ArithmeticOp;
/*  51 */ ArithmeticExprList /* Vec<T>::New */: ;
/*  52 */ ArithmeticOp: '+';
/*  53 */ ArithmeticOp: '-';
/*  54 */ FactorExpr: FactorExprList /* Vec */ PrefixExpr;
/*  55 */ FactorExprList /* Vec<T>::Push */: FactorExprList PrefixExpr FactorOp;
/*  56 */ FactorExprList /* Vec<T>::New */: ;
/*  57 */ FactorOp: '*';
/*  58 */ FactorOp: '/';
/*  59 */ FactorOp: '%';
/*  60 */ PrefixExpr: '-' ApplyExpr;
/*  61 */ PrefixExpr: PrefixExprList /* Vec */ ApplyExpr;
/*  62 */ PrefixExprList /* Vec<T>::Push */: PrefixExprList Qualif;
/*  63 */ PrefixExprList /* Vec<T>::New */: ;
/*  64 */ ApplyExpr: LowerPrefixExpr ApplyExprList /* Vec */;
/*  65 */ ApplyExprList /* Vec<T>::Push */: ApplyExprList AtomicExpr;
/*  66 */ ApplyExprList /* Vec<T>::New */: ;
/*  67 */ LowerPrefixExpr: LowerPrefixExprOpt /* Option */ Callable;
/*  68 */ LowerPrefixExprOpt /* Option<T>::Some */: LowerPrefixOp;
/*  69 */ LowerPrefixExprOpt /* Option<T>::None */: ;
/*  70 */ LowerPrefixOp: '&';
/*  71 */ LowerPrefixOp: '$';
/*  72 */ Callable: Path;
/*  73 */ Callable: Literal;
/*  74 */ Callable: '(' Expr ')';
/*  75 */ AtomicExpr: Qualif;
/*  76 */ AtomicExpr: ImportExpr;
/*  77 */ AtomicExpr: IfExpr;
/*  78 */ ImportExpr: LowerPrefixExpr ImportExprOpt /* Option */;
/*  79 */ ImportExprOpt /* Option<T>::Some */: '?' Path;
/*  80 */ ImportExprOpt /* Option<T>::None */: ;
/*  81 */ IfExpr: 'if' Expr Block IfExprOpt /* Option */;
/*  82 */ IfExprOpt /* Option<T>::Some */: 'else' Block;
/*  83 */ IfExprOpt /* Option<T>::None */: ;
/*  84 */ Qualif: KindSpec;
/*  85 */ Qualif: DefaultAttr;
/*  86 */ DefaultAttr: '~' Path;
/*  87 */ KindSpec: '@' Path KindSpecOpt /* Option */;
/*  88 */ KindSpecOpt /* Option<T>::Some */: KindArg;
/*  89 */ KindSpecOpt /* Option<T>::None */: ;
/*  90 */ KindArg: ':' Callable;
/*  91 */ Path: Ident PathList /* Vec */;
/*  92 */ PathList /* Vec<T>::Push */: PathList '.' Ident;
/*  93 */ PathList /* Vec<T>::New */: ;
/*  94 */ Ident: /[_a-zA-Z](\w|[\/-])*/;
/*  95 */ Literal: Array;
/*  96 */ Literal: String;
/*  97 */ Literal: ByteLiteral;
/*  98 */ Literal: HexByteLiteral;
/*  99 */ Literal: Numeric;
/* 100 */ Literal: Rfc3339DateTime;
/* 101 */ Array: '[' ArrayOpt /* Option */ ']';
/* 102 */ ArrayOpt /* Option<T>::Some */: CommaSepElements;
/* 103 */ ArrayOpt /* Option<T>::None */: ;
/* 104 */ CommaSepElements: Expr CommaSepElementsOpt /* Option */;
/* 105 */ CommaSepElementsOpt /* Option<T>::Some */: CommaExprList;
/* 106 */ CommaSepElementsOpt /* Option<T>::None */: ;
/* 107 */ CommaExprList: ',' CommaExprListOpt /* Option */;
/* 108 */ CommaExprListOpt /* Option<T>::Some */: CommaSepElements;
/* 109 */ CommaExprListOpt /* Option<T>::None */: ;
/* 110 */ String: /"(\\.|[^"])*"/;
/* 111 */ ByteLiteral: /b"(\\.|[^"])*"/;
/* 112 */ HexByteLiteral: /bx"[0-9a-fA-F_]*"/;
/* 113 */ Numeric: BinaryInteger;
/* 114 */ Numeric: OctalInteger;
/* 115 */ Numeric: HexadecimalInteger;
/* 116 */ Numeric: Ieee754Float;
/* 117 */ BinaryInteger: /0b[01_]+([a-zA-Z](\w|[\/-])*)?/;
/* 118 */ OctalInteger: /0o[0-7_]+([a-zA-Z](\w|[\/-])*)?/;
/* 119 */ HexadecimalInteger: /0x[0-9a-fA-F_]+([g-zG-Z](\w|[\/-])*)?/;
/* 120 */ Ieee754Float: /[-+]?(0|[1-9][0-9_]*)(\.[0-9_]+)?([eE][-+]?(0|[1-9][0-9_]*)?)?([a-df-zA-DF-Z](\w|[\/-])*)?/;
/* 121 */ Rfc3339DateTime: /\d{4}-\d{2}-\d{2}[tT]\d{2}:\d{2}:\d{2}(.\d+)?([zZ]|[+-]\d{2}:\d{2})/;
/* 122 */ ReturnStmt: 'return';
/* 123 */ Block: '{' Scope '}';
