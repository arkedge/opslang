%start Program
%title "opslang v1 grammar"
%grammar_type 'lalr(1)'
%auto_newline_off
%on Hash %enter Cmnt

%scanner Cmnt {
    %auto_newline_off
    %auto_ws_off
    %on EndOfLine %enter INITIAL
}

%%

/*   0 */ EndOfLine: <INITIAL, Cmnt>/(?:\r?\n|\r)+/;
/*   1 */ Comment: Hash^ /* Clipped */ CommentContent;
/*   2 */ Hash: '#';
/*   3 */ CommentContent: <Cmnt>/[^\r\n]*/;
/*   4 */ Program: Scope;
/*   5 */ Scope: ScopeList /* Vec */;
/*   6 */ ScopeList /* Vec<T>::Push */: ScopeList ScopeContent;
/*   7 */ ScopeList /* Vec<T>::New */: ;
/*   8 */ ScopeContent: ScopeContentOpt /* Option */ ScopeContentOpt0 /* Option */ ScopeContentOpt1 /* Option */ EndOfLine;
/*   9 */ ScopeContentOpt1 /* Option<T>::Some */: Comment;
/*  10 */ ScopeContentOpt1 /* Option<T>::None */: ;
/*  11 */ ScopeContentOpt0 /* Option<T>::Some */: ScopeContentKind;
/*  12 */ ScopeContentOpt0 /* Option<T>::None */: ;
/*  13 */ ScopeContentOpt /* Option<T>::Some */: Break;
/*  14 */ ScopeContentOpt /* Option<T>::None */: ;
/*  15 */ ScopeContentKind: Statement;
/*  16 */ ScopeContentKind: Block;
/*  17 */ Statement: StatementKind Semi;
/*  18 */ Break: '.';
/*  19 */ Semi: ';';
/*  20 */ StatementKind: LetStmt;
/*  21 */ StatementKind: Expr;
/*  22 */ StatementKind: ReturnStmt;
/*  23 */ LetStmt: 'let' Ident '=' Expr;
/*  24 */ Expr: SetExpr;
/*  25 */ SetExpr: InfixIfExpr SetExprOpt /* Option */;
/*  26 */ SetExprOpt /* Option<T>::Some */: ':=' InfixIfExpr;
/*  27 */ SetExprOpt /* Option<T>::None */: ;
/*  28 */ InfixIfExpr: LogicalOrExpr InfixIfExprOpt /* Option */;
/*  29 */ InfixIfExprOpt /* Option<T>::Some */: 'if' LogicalOrExpr;
/*  30 */ InfixIfExprOpt /* Option<T>::None */: ;
/*  31 */ LogicalOrExpr: LogicalAndExpr LogicalOrExprList /* Vec */;
/*  32 */ LogicalOrExprList /* Vec<T>::Push */: LogicalOrExprList '||' LogicalAndExpr;
/*  33 */ LogicalOrExprList /* Vec<T>::New */: ;
/*  34 */ LogicalAndExpr: InfixInExpr LogicalAndExprList /* Vec */;
/*  35 */ LogicalAndExprList /* Vec<T>::Push */: LogicalAndExprList '&&' InfixInExpr;
/*  36 */ LogicalAndExprList /* Vec<T>::New */: ;
/*  37 */ InfixInExpr: CompareExpr InfixInExprOpt /* Option */;
/*  38 */ InfixInExprOpt /* Option<T>::Some */: 'in' CompareExpr;
/*  39 */ InfixInExprOpt /* Option<T>::None */: ;
/*  40 */ CompareExpr: ArithmeticExpr CompareExprList /* Vec */;
/*  41 */ CompareExprList /* Vec<T>::Push */: CompareExprList CompareOp ArithmeticExpr;
/*  42 */ CompareExprList /* Vec<T>::New */: ;
/*  43 */ CompareOp: '>=';
/*  44 */ CompareOp: '<=';
/*  45 */ CompareOp: '>';
/*  46 */ CompareOp: '<';
/*  47 */ CompareOp: '!=';
/*  48 */ CompareOp: '/=';
/*  49 */ CompareOp: '==';
/*  50 */ ArithmeticExpr: FactorExpr ArithmeticExprList /* Vec */;
/*  51 */ ArithmeticExprList /* Vec<T>::Push */: ArithmeticExprList ArithmeticOp FactorExpr;
/*  52 */ ArithmeticExprList /* Vec<T>::New */: ;
/*  53 */ ArithmeticOp: '+';
/*  54 */ ArithmeticOp: '-';
/*  55 */ FactorExpr: PrefixExpr FactorExprList /* Vec */;
/*  56 */ FactorExprList /* Vec<T>::Push */: FactorExprList FactorOp PrefixExpr;
/*  57 */ FactorExprList /* Vec<T>::New */: ;
/*  58 */ FactorOp: '*';
/*  59 */ FactorOp: '/';
/*  60 */ FactorOp: '%';
/*  61 */ PrefixExpr: PrefixOp ApplyExpr;
/*  62 */ PrefixExpr: PrefixExprList /* Vec */ ApplyExpr;
/*  63 */ PrefixExprList /* Vec<T>::Push */: PrefixExprList Qualif;
/*  64 */ PrefixExprList /* Vec<T>::New */: ;
/*  65 */ PrefixOp: '-';
/*  66 */ PrefixOp: '&';
/*  67 */ ApplyExpr: Callable ApplyExprList /* Vec */;
/*  68 */ ApplyExprList /* Vec<T>::Push */: ApplyExprList AtomicExpr;
/*  69 */ ApplyExprList /* Vec<T>::New */: ;
/*  70 */ Callable: Path;
/*  71 */ Callable: Literal;
/*  72 */ Callable: '(' Expr ')';
/*  73 */ AtomicExpr: Qualif;
/*  74 */ AtomicExpr: Callable;
/*  75 */ Qualif: ExecutorComponent;
/*  76 */ Qualif: TimeIndicator;
/*  77 */ ExecutorComponent: '@' Path;
/*  78 */ TimeIndicator: ':' Callable;
/*  79 */ Path: Ident PathList /* Vec */;
/*  80 */ PathList /* Vec<T>::Push */: PathList '.' Ident;
/*  81 */ PathList /* Vec<T>::New */: ;
/*  82 */ Ident: /[_a-zA-Z](\w|[\/-])*/;
/*  83 */ Literal: Array;
/*  84 */ Literal: String;
/*  85 */ Literal: ByteLiteral;
/*  86 */ Literal: HexByteLiteral;
/*  87 */ Literal: Numeric;
/*  88 */ Literal: FilePathLiteral;
/*  89 */ Literal: Rfc3339DateTime;
/*  90 */ Array: '[' ArrayOpt /* Option */ ']';
/*  91 */ ArrayOpt /* Option<T>::Some */: CommaSepElements;
/*  92 */ ArrayOpt /* Option<T>::None */: ;
/*  93 */ CommaSepElements: Expr CommaSepElementsOpt /* Option */;
/*  94 */ CommaSepElementsOpt /* Option<T>::Some */: CommaExprList;
/*  95 */ CommaSepElementsOpt /* Option<T>::None */: ;
/*  96 */ CommaExprList: ',' CommaExprListOpt /* Option */;
/*  97 */ CommaExprListOpt /* Option<T>::Some */: CommaSepElements;
/*  98 */ CommaExprListOpt /* Option<T>::None */: ;
/*  99 */ String: /"(\\.|[^"])*"/;
/* 100 */ ByteLiteral: /b"(\\.|[^"])*"/;
/* 101 */ HexByteLiteral: /bx"[0-9a-fA-F_]*"/;
/* 102 */ Numeric: BinaryInteger;
/* 103 */ Numeric: OctalInteger;
/* 104 */ Numeric: HexadecimalInteger;
/* 105 */ Numeric: Ieee754Float;
/* 106 */ BinaryInteger: /0b[01_]+([a-zA-Z](\w|[\/-])*)?/;
/* 107 */ OctalInteger: /0o[0-7_]+([a-zA-Z](\w|[\/-])*)?/;
/* 108 */ HexadecimalInteger: /0x[0-9a-fA-F_]+([g-zG-Z](\w|[\/-])*)?/;
/* 109 */ Ieee754Float: /[-+]?(0|[1-9][0-9_]*)(\.[0-9_]+)?([eE][-+]?(0|[1-9][0-9_]*)?)?([a-df-zA-DF-Z](\w|[\/-])*)?/;
/* 110 */ FilePathLiteral: /os"[0-9a-zA-Z_.,-\/()\[\]]*"/;
/* 111 */ Rfc3339DateTime: /\d{4}-\d{2}-\d{2}[tT]\d{2}:\d{2}:\d{2}(.\d+)?([zZ]|[+-]\d{2}:\d{2})/;
/* 112 */ ReturnStmt: 'return';
/* 113 */ Block: '{' Scope '}';
